# Redirect only the production hostname; preserve local development and ACME checks.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^mis\.badmaal\.so$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://mis.badmaal.so%{REQUEST_URI} [R=301,L]
</IfModule>

Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<FilesMatch "(^\.|^error_log$|\.(sql|log|bak|ini|json)$)">
Require all denied
</FilesMatch>

Require all granted
